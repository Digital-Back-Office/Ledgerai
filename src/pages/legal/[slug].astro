---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopBar from "../../components/TopBar.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import CookieConsent from "../../components/CookieConsent.astro";
import PageHead from "../../components/PageHead.astro";
import Toc from "../../components/Toc.astro";
import { formatDate, getLegalPages, getSite } from "../../lib/content";
import { breadcrumbs } from "../../lib/schema";

export const getStaticPaths: GetStaticPaths = async () => {
  const pages = await getLegalPages();
  return pages.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
};

const brand = await getSite("brand");
const { entry } = Astro.props;
const page = entry.data;

// Compiled to HTML at build time, exactly as the blog posts are — crawlers get
// the full policy text rather than an empty container. `headings` feeds the
// "on this page" list.
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2);

const pages = await getLegalPages();

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: page.title,
    description: page.summary,
    url: `${(brand.url ?? "").replace(/\/$/, "")}/legal/${entry.id}`,
    dateModified: page.updated,
    inLanguage: "en-GB",
    isPartOf: { "@id": `${(brand.url ?? "").replace(/\/$/, "")}/#website` },
    publisher: { "@id": `${(brand.url ?? "").replace(/\/$/, "")}/#organization` },
  },
  breadcrumbs(brand, [
    { name: "Home", item: "/" },
    { name: page.title, item: `/legal/${entry.id}` },
  ]),
];
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  canonical={`/legal/${entry.id}`}
  ogTitle={page.seo.title}
  ogDescription={page.seo.description}
  jsonLd={jsonLd}
>
  <TopBar />
  <Nav />

  <main id="main">
    <PageHead trail={[{ name: page.title }]} label="Legal" lede={page.summary}>
      <Fragment slot="title">{page.title}</Fragment>
      <p slot="meta" class="anim anim-up mt-6 text-sm text-mute" style="--anim-delay: 0.2s">
        Last updated <time class="fig text-ink" datetime={page.updated}
          >{formatDate(page.updated)}</time
        >
      </p>
    </PageHead>

    <div class="wrap pt-12 pb-20 lg:pt-16 lg:pb-28">
      <div class="grid grid-cols-1 gap-x-12 gap-y-10 lg:grid-cols-12">
        <aside
          class="lg:col-span-3 lg:sticky lg:top-32 lg:self-start lg:max-h-[calc(100dvh-9rem)] lg:overflow-y-auto lg:pr-2"
        >
          {/* Sibling policies, so a visitor who lands on one can reach the rest. */}
          <nav aria-label="Legal pages">
            <ul class="cells grid-cols-2 lg:grid-cols-1">
              {
                pages.map((other) => (
                  <li class="last:odd:col-span-2 lg:last:odd:col-span-1">
                    <a
                      href={`/legal/${other.id}`}
                      aria-current={other.id === entry.id ? "page" : undefined}
                      class="block px-4 py-3 text-[0.9375rem] font-medium text-mute transition-colors hover:text-ink aria-[current=page]:bg-ink aria-[current=page]:text-white"
                    >
                      {other.data.shortTitle}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          {
            toc.length > 1 && (
              <nav aria-label="On this page" class="hidden lg:block mt-10">
                <p class="label mb-4">On this page</p>
                <Toc headings={toc} />
              </nav>
            )
          }
        </aside>

        <div class="min-w-0 lg:col-span-8 lg:col-start-5">
          <div class="prose-content select-text [&>*:first-child]:mt-0">
            <Content />
          </div>

          <p class="mt-14 pt-6 border-t border-rule text-mute">
            Questions about this page? <a href="/#book-demo" class="link">Get in touch</a>.
          </p>
        </div>
      </div>
    </div>
  </main>

  <Footer />
  <CookieConsent />
</BaseLayout>
