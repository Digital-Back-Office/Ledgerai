---
/**
 * /pricing — the three subscription tiers, a side-by-side comparison and the
 * pricing FAQs.
 *
 * Plans come from `src/content/plans/*.md` and the page copy from
 * `src/content/sections/pricing.md`, so a price change is a markdown edit. Both
 * monthly and yearly prices are in the HTML; the toggle only swaps which is
 * visible, so crawlers and no-JS visitors still see monthly by default.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import TopBar from "../components/TopBar.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BookDemoSection from "../components/BookDemoSection.astro";
import CookieConsent from "../components/CookieConsent.astro";
import Icon from "../components/Icon.astro";
import { getOrdered, getSection, getSite } from "../lib/content";
import { breadcrumbs, faqPage, organization, website } from "../lib/schema";

const brand = await getSite("brand");
const section = await getSection("pricing");
const plans = await getOrdered("plans");
const { billing, comparison, faqs } = section;

const site = (brand.url ?? "").replace(/\/$/, "");

/** 9.99 -> "9.99", 1999 -> "1,999", 83.25 -> "83.25" */
const gbp = (amount: number) =>
  Number.isInteger(amount)
    ? amount.toLocaleString("en-GB")
    : amount.toLocaleString("en-GB", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const priced = plans.map((plan) => {
  const { monthlyPrice, yearlyPrice } = plan.data;
  const saving = Math.round((monthlyPrice * 12 - yearlyPrice) * 100) / 100;
  return {
    ...plan.data,
    saving,
    yearlyPerMonth: Math.round((yearlyPrice / 12) * 100) / 100,
  };
});

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@graph": [
      organization(brand),
      website(brand),
      {
        "@type": "WebPage",
        "@id": `${site}/pricing#webpage`,
        url: `${site}/pricing`,
        name: section.pageTitle,
        description: section.pageDescription,
        inLanguage: "en-GB",
        isPartOf: { "@id": `${site}/#website` },
        publisher: { "@id": `${site}/#organization` },
      },
      {
        "@type": "SoftwareApplication",
        "@id": `${site}/pricing#software`,
        name: brand.name,
        applicationCategory: "BusinessApplication",
        operatingSystem: "All",
        description: brand.applicationDescription,
        offers: priced.flatMap((plan) => [
          {
            "@type": "Offer",
            name: `${plan.name} (monthly)`,
            price: plan.monthlyPrice.toFixed(2),
            priceCurrency: "GBP",
            url: `${site}/pricing`,
          },
          {
            "@type": "Offer",
            name: `${plan.name} (yearly)`,
            price: plan.yearlyPrice.toFixed(2),
            priceCurrency: "GBP",
            url: `${site}/pricing`,
          },
        ]),
      },
      ...(faqs.length ? [faqPage(brand, faqs, "/pricing")] : []),
    ],
  },
  breadcrumbs(brand, [
    { name: "Home", item: "/" },
    { name: "Pricing", item: "/pricing" },
  ]),
];

const sectionEyebrow = "text-[11px] font-bold uppercase tracking-[0.15em] text-[#13b5ea] mb-3";
const sectionHeading = "text-[2.2rem] font-extrabold text-slate-900 tracking-tight";

const ctaClass = (style: string) =>
  style === "primary"
    ? "inline-flex w-full items-center justify-center gap-2 bg-[#13b5ea] text-white font-semibold px-6 py-3.5 rounded-xl hover:bg-[#0e9fd2] transition-colors shadow-lg shadow-[#13b5ea]/30"
    : "inline-flex w-full items-center justify-center gap-2 bg-white text-slate-700 font-semibold px-6 py-3.5 rounded-xl border border-slate-200 hover:border-[#13b5ea] hover:text-[#13b5ea] transition-colors";
---

<BaseLayout
  title={section.pageTitle!}
  description={section.pageDescription}
  canonical="/pricing"
  jsonLd={jsonLd}
>
  <TopBar />
  <Nav />

  <div class="bg-white border-b border-slate-100">
    <div class="max-w-6xl mx-auto px-6 py-6">
      <nav
        aria-label="Breadcrumb"
        class="flex items-center gap-2 text-xs font-medium text-slate-500 flex-wrap"
      >
        <a href="/" class="hover:text-[#13b5ea] flex items-center gap-1 transition-colors">
          <Icon name="Home" size={12} /> Home
        </a>
        <Icon name="ChevronRight" size={10} class="text-slate-400" />
        <span class="text-slate-800" aria-current="page">Pricing</span>
      </nav>
    </div>
  </div>

  <main data-billing="monthly" id="pricing-root">
    {/* ── Header + toggle ─────────────────────────────────────────────── */}
    <section class="bg-white">
      <div class="max-w-4xl mx-auto px-6 pt-16 pb-12 text-center">
        <div
          class="anim anim-up inline-flex items-center gap-2 bg-[#13b5ea]/10 text-[#13b5ea] text-xs font-bold px-4 py-2 rounded-full mb-7 uppercase tracking-widest"
          style="--anim-delay: 0.1s"
        >
          <Icon name="Sparkles" size={12} />
          {section.badge}
        </div>

        <h1
          class="anim anim-up text-4xl sm:text-5xl font-bold text-gray-900 leading-[1.1] tracking-tight mb-6"
          style="--anim-delay: 0.2s"
        >
          {section.headline?.before}<span class="text-[#13b5ea]">{section.headline?.accent}</span
          >{section.headline?.after}
        </h1>

        <p
          class="anim anim-up text-lg text-gray-600 leading-relaxed max-w-2xl mx-auto mb-10"
          style="--anim-delay: 0.3s"
        >
          {section.subheading}
        </p>

        {
          billing && (
            <div
              class="anim anim-up inline-flex items-center gap-1 bg-slate-100 rounded-full p-1"
              style="--anim-delay: 0.4s"
              role="group"
              aria-label="Billing period"
            >
              <button
                type="button"
                data-billing-option="monthly"
                aria-pressed="true"
                class="billing-btn px-5 py-2 rounded-full text-sm font-semibold transition-colors"
              >
                {billing.monthlyLabel}
              </button>
              <button
                type="button"
                data-billing-option="yearly"
                aria-pressed="false"
                class="billing-btn flex items-center gap-2 px-5 py-2 rounded-full text-sm font-semibold transition-colors"
              >
                {billing.yearlyLabel}
                <span class="text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full">
                  {billing.yearlyNote}
                </span>
              </button>
            </div>
          )
        }
      </div>
    </section>

    {/* ── Plan cards ──────────────────────────────────────────────────── */}
    <section class="max-w-6xl mx-auto px-6 pb-20">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch">
        {
          priced.map((plan, i) => (
            <article
              class:list={[
                "anim anim-up relative flex flex-col rounded-2xl p-7 sm:p-8 bg-white transition-all",
                plan.featured
                  ? "border-2 border-[#13b5ea] shadow-xl shadow-[#13b5ea]/15 lg:-translate-y-2"
                  : "border border-slate-200 shadow-sm hover:shadow-md",
              ]}
              style={`--anim-delay: ${(0.1 + i * 0.1).toFixed(2)}s`}
            >
              {plan.badge && (
                <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-[#13b5ea] text-white text-[11px] font-bold uppercase tracking-widest px-4 py-1.5 rounded-full shadow-md whitespace-nowrap">
                  {plan.badge}
                </span>
              )}

              <h2 class="text-xl font-bold text-slate-900">{plan.name}</h2>
              <p class="text-slate-500 text-sm leading-relaxed mt-2 min-h-[2.75rem]">
                {plan.tagline}
              </p>

              <div class="mt-6 mb-1">
                <p data-price="monthly" class="flex items-baseline gap-1.5">
                  <span class="text-4xl font-extrabold text-slate-900 tracking-tight">
                    £{gbp(plan.monthlyPrice)}
                  </span>
                  <span class="text-slate-400 text-sm font-medium">/ month</span>
                </p>
                <p data-price="yearly" class="hidden items-baseline gap-1.5">
                  <span class="text-4xl font-extrabold text-slate-900 tracking-tight">
                    £{gbp(plan.yearlyPrice)}
                  </span>
                  <span class="text-slate-400 text-sm font-medium">/ year</span>
                </p>
              </div>
              <p data-price="monthly" class="text-xs text-slate-400 h-5">
                or £{gbp(plan.yearlyPrice)} billed yearly
              </p>
              <p data-price="yearly" class="hidden text-xs text-emerald-600 font-semibold h-5">
                ≈ £{gbp(plan.yearlyPerMonth)}/month · save £{gbp(plan.saving)}
              </p>

              <div class="mt-6">
                <a
                  href={plan.cta.href}
                  target={plan.cta.external ? "_blank" : undefined}
                  rel={plan.cta.external ? "noopener noreferrer" : undefined}
                  class={ctaClass(plan.cta.style)}
                  data-event="cta_click"
                  data-event-label={plan.cta.event}
                >
                  {plan.cta.label}
                  <Icon name="ArrowRight" size={17} />
                </a>
              </div>

              <dl class="mt-7 pt-6 border-t border-slate-100 space-y-3 text-sm">
                {plan.allowances.map((item) => (
                  <div class="flex items-start justify-between gap-4">
                    <dt class="text-slate-500">{item.label}</dt>
                    <dd class="text-right">
                      <span class="font-semibold text-slate-800">{item.value}</span>
                      {item.note && (
                        <span class="block text-[11px] text-slate-400 font-mono">{item.note}</span>
                      )}
                    </dd>
                  </div>
                ))}
              </dl>

              <ul class="mt-6 pt-6 border-t border-slate-100 space-y-3 text-sm">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-2.5 text-slate-700">
                    <Icon name="Check" size={16} class="text-[#13b5ea] shrink-0 mt-0.5" />
                    {feature}
                  </li>
                ))}
              </ul>

              {plan.extras.length > 0 && (
                <div class="mt-6 rounded-xl bg-[#13b5ea]/5 border border-[#13b5ea]/15 p-5">
                  {plan.extrasHeading && (
                    <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-[#13b5ea] mb-3">
                      {plan.extrasHeading}
                    </p>
                  )}
                  <ul class="space-y-2.5 text-sm">
                    {plan.extras.map((extra) => (
                      <li class="flex items-start gap-2.5 text-slate-700">
                        <Icon name="Sparkles" size={15} class="text-[#13b5ea] shrink-0 mt-0.5" />
                        {extra}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </article>
          ))
        }
      </div>

      {
        section.trustPoints.length > 0 && (
          <div class="anim anim-fade flex flex-wrap items-center justify-center gap-x-6 gap-y-2 mt-12 text-sm text-gray-500">
            {section.trustPoints.map((point) => (
              <span class="flex items-center gap-1.5">
                <Icon name="Check" size={14} class="text-[#13b5ea]" />
                {point}
              </span>
            ))}
          </div>
        )
      }
    </section>

    {/* ── Comparison table ────────────────────────────────────────────── */}
    {
      comparison && (
        <section id="compare" class="bg-slate-50 border-y border-slate-100 py-24">
          <div class="max-w-5xl mx-auto px-6">
            <div class="anim anim-up text-center mb-12">
              <p class={sectionEyebrow}>{comparison.eyebrow}</p>
              <h2 class={sectionHeading}>{comparison.heading}</h2>
            </div>

            <div class="anim anim-up overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
              <table class="w-full min-w-[640px] text-sm">
                <thead>
                  <tr class="border-b border-slate-200">
                    <th scope="col" class="text-left font-semibold text-slate-500 px-5 py-4 w-[34%]">
                      <span class="sr-only">Feature</span>
                    </th>
                    {priced.map((plan) => (
                      <th
                        scope="col"
                        class:list={[
                          "px-5 py-4 text-center font-bold text-base",
                          plan.featured ? "text-[#13b5ea] bg-[#13b5ea]/5" : "text-slate-900",
                        ]}
                      >
                        {plan.name}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {comparison.rows.map((row) => (
                    <tr class="border-b border-slate-100 last:border-0">
                      <th scope="row" class="text-left font-medium text-slate-700 px-5 py-3.5">
                        {row.label}
                      </th>
                      {row.values.map((value, i) => (
                        <td
                          class:list={[
                            "px-5 py-3.5 text-center text-slate-600",
                            priced[i]?.featured && "bg-[#13b5ea]/5",
                          ]}
                        >
                          {value === true ? (
                            <Icon name="Check" size={17} class="text-[#13b5ea] inline-block" title="Included" />
                          ) : value === false ? (
                            <span class="text-slate-300" aria-label="Not included">—</span>
                          ) : (
                            value
                          )}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </section>
      )
    }

    {/* ── FAQs ────────────────────────────────────────────────────────── */}
    {
      faqs.length > 0 && (
        <section id="faq" class="py-24 max-w-6xl mx-auto px-6">
          <div class="anim anim-up text-center mb-14">
            <p class={sectionEyebrow}>FAQs</p>
            <h2 class={sectionHeading}>Pricing questions</h2>
          </div>

          <div class="space-y-4 max-w-3xl mx-auto">
            {faqs.map((faq, i) => (
              <details
                name="pricing-faq"
                class="anim anim-up group bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden transition-all hover:border-slate-300"
                style={`--anim-delay: ${(i * 0.06).toFixed(2)}s`}
              >
                <summary class="w-full px-6 py-4.5 flex items-center justify-between text-left font-bold text-slate-800 text-base sm:text-lg hover:text-[#13b5ea] transition-colors cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                  <span>{faq.question}</span>
                  <span class="text-slate-400 shrink-0 ml-4 transition-transform duration-200 group-open:rotate-180">
                    <Icon name="ChevronDown" size={18} />
                  </span>
                </summary>
                <div class="px-6 pb-5 pt-1 text-slate-500 text-sm sm:text-base leading-relaxed border-t border-slate-100/50">
                  {faq.answer}
                </div>
              </details>
            ))}
          </div>
        </section>
      )
    }

    <BookDemoSection />
  </main>

  <Footer />
  <CookieConsent />
</BaseLayout>

<style>
  .billing-btn {
    color: rgb(100 116 139);
  }
  .billing-btn[aria-pressed="true"] {
    background: white;
    color: rgb(15 23 42);
    box-shadow: 0 1px 3px rgb(15 23 42 / 0.1);
  }
  /* Monthly is the default in the HTML; this flips the pair once yearly is picked. */
  [data-billing="yearly"] [data-price="monthly"] {
    display: none;
  }
  [data-billing="yearly"] p[data-price="yearly"] {
    display: flex;
  }
  [data-billing="yearly"] p[data-price="yearly"].text-xs {
    display: block;
  }
</style>

<script>
  const root = document.getElementById("pricing-root");
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-billing-option]");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const period = button.dataset.billingOption!;
      if (root) root.dataset.billing = period;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
      window.gtag?.("event", "pricing_billing_toggle", {
        event_category: "engagement",
        event_label: period,
      });
    });
  });

  document.querySelectorAll<HTMLElement>("[data-event='cta_click']").forEach((el) => {
    el.addEventListener("click", () => {
      window.gtag?.("event", "cta_click", {
        event_category: "engagement",
        event_label: el.dataset.eventLabel ?? "pricing",
      });
    });
  });
</script>
