---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopBar from "../components/TopBar.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import { getSection } from "../lib/content";

const section = await getSection("not-found");
---

<BaseLayout title={section.pageTitle!} description={section.pageDescription} noindex>
  <div class="min-h-dvh flex flex-col bg-paper grid-paper">
    <TopBar />
    <Nav />
    <main id="main" class="wrap grow flex flex-col justify-center py-20">
      <p
        aria-hidden="true"
        class="font-display font-bold tracking-tighter leading-none text-ink text-[clamp(6rem,22vw,15rem)]"
      >
        4<span class="text-brand">0</span>4
      </p>
      <h1 class="h-section mt-6">{section.heading}</h1>
      <p class="lede mt-4 max-w-[48ch]">{section.subheading}</p>
      <div class="flex flex-wrap gap-3 mt-9">
        <a href={section.ctas[0]?.href} class="btn btn-primary">
          <Icon name="ArrowLeft" size={16} />
          {section.ctas[0]?.label}
        </a>
        <a href="/" class="btn btn-line">Home</a>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
