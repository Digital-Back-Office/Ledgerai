---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopBar from "../../components/TopBar.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import PageHead from "../../components/PageHead.astro";
import { formatDate, getPosts, getSection, getSite } from "../../lib/content";
import { blogIndex, breadcrumbs } from "../../lib/schema";

const brand = await getSite("brand");
const section = await getSection("blog-index");
const cta = await getSection("blog-cta");
const posts = await getPosts();

const categories = [
  section.allCategoriesLabel ?? "All",
  ...new Set(posts.map((post) => post.data.category)),
];

/**
 * The React list searched titles, excerpts *and* body text. Each card carries a
 * pre-lowercased haystack so the same search works without shipping the posts
 * twice or needing a runtime fetch.
 */
const haystack = (post: (typeof posts)[number]) =>
  [post.data.title, post.data.excerpt, post.data.category, post.body ?? ""]
    .join(" ")
    .toLowerCase();

const jsonLd = [
  blogIndex(
    brand,
    { name: section.pageTitle!, description: section.pageDescription! },
    posts.map((post) => ({ id: post.id, data: post.data }))
  ),
  breadcrumbs(brand, [
    { name: "Home", item: "/" },
    { name: "Blogs", item: "/blogs" },
  ]),
];
---

<BaseLayout
  title={section.pageTitle!}
  description={section.pageDescription}
  canonical="/blogs"
  ogTitle={section.pageTitle}
  ogDescription="Explore expert financial guidance, compliance advice, and bookkeeping strategies for UK businesses."
  jsonLd={jsonLd}
>
  <TopBar />
  <Nav />

  <main id="main">
    <PageHead trail={[{ name: "Blogs" }]} label={section.badge} lede={section.subheading}>
      <Fragment slot="title">
        {section.headline?.before}{" "}<span class="mark">{section.headline?.accent}</span>{" "}
        {section.headline?.after}
      </Fragment>
    </PageHead>

    <div class="wrap pt-8 pb-20 lg:pt-10 lg:pb-28">
      {/* Search & filter */}
      <div
        data-blog-filters
        class="flex flex-col md:flex-row md:items-end justify-between gap-5 border-b border-ink"
      >
        <div class="flex items-center gap-6 overflow-x-auto scrollbar-none -mb-px">
          {
            categories.map((category, i) => (
              <button
                type="button"
                data-category={category}
                aria-pressed={i === 0 ? "true" : "false"}
                class="py-3 border-b-2 border-transparent text-[0.9375rem] font-medium text-mute whitespace-nowrap cursor-pointer transition-colors hover:text-ink aria-pressed:text-ink aria-pressed:border-brand"
              >
                {category}
              </button>
            ))
          }
        </div>

        <div class="relative w-full md:w-72 mb-3">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-mute pointer-events-none">
            <Icon name="Search" size={16} />
          </span>
          <label for="blog-search" class="sr-only">{section.searchPlaceholder}</label>
          <input
            id="blog-search"
            type="search"
            data-blog-search
            placeholder={section.searchPlaceholder}
            class="field pl-10 min-h-11"
          />
        </div>
      </div>

      {/* Every post is rendered server-side; filtering only hides rows. */}
      <div data-blog-grid class="border-b border-rule">
        {
          posts.map((post, i) => (
            <article
              data-post
              data-category={post.data.category}
              data-search={haystack(post)}
              class="anim anim-up group grid gap-x-10 gap-y-5 border-t border-rule first:border-t-0 py-8 lg:py-10 md:grid-cols-12 md:items-center"
              style={`--anim-delay: ${(i * 0.05).toFixed(2)}s`}
            >
              <a
                href={`/blogs/${post.id}`}
                tabindex="-1"
                aria-hidden="true"
                class="block md:col-span-4 aspect-[3/2] overflow-hidden rounded-md bg-paper"
              >
                <img
                  src={post.data.coverImage}
                  alt=""
                  width="640"
                  height="427"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                />
              </a>

              <div class="md:col-span-8">
                <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.8125rem] text-mute mb-3">
                  <span class="max-sm:w-full font-medium text-ink">{post.data.category}</span>
                  <span aria-hidden="true" class="max-sm:hidden text-rule">/</span>
                  <time class="fig" datetime={post.data.date}>{formatDate(post.data.date)}</time>
                  <span aria-hidden="true" class="text-rule">/</span>
                  <span class="fig">{post.data.readingTime}</span>
                </p>

                <h2 class="font-display font-semibold text-2xl lg:text-[1.75rem] leading-[1.15] tracking-tight text-ink max-w-[30ch]">
                  <a
                    href={`/blogs/${post.id}`}
                    class="group-hover:underline decoration-brand decoration-2 underline-offset-4"
                  >
                    {post.data.title}
                  </a>
                </h2>

                <p class="text-mute leading-relaxed mt-3 max-w-[64ch] line-clamp-2">
                  {post.data.excerpt}
                </p>
              </div>
            </article>
          ))
        }
      </div>

      <div data-blog-empty hidden class="border-b border-rule py-16">
        <p class="h-row mb-3">{section.emptyState?.message}</p>
        <button type="button" data-blog-reset class="link cursor-pointer">
          {section.emptyState?.action}
        </button>
      </div>
    </div>

    {/* CTA */}
    <section class="bg-brand text-ink">
      <div class="wrap py-16 lg:py-20 grid gap-x-12 gap-y-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="text-sm font-medium mb-4">{cta.eyebrow}</p>
          <h2 class="h-section max-w-[20ch]">{cta.heading}</h2>
          <p class="mt-4 text-lg leading-relaxed text-ink/80 max-w-[58ch]">{cta.subheading}</p>
        </div>
        <div class="lg:col-span-4 flex flex-col sm:flex-row gap-3 lg:justify-self-end">
          <a href={cta.ctas[0]?.href} class="btn btn-ink">
            {cta.ctas[0]?.label}
            <Icon name="ArrowRight" size={16} class="arrow" />
          </a>
          <a href={cta.ctas[1]?.href} class="btn btn-line border-ink/40">
            {cta.ctas[1]?.label}
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  const filters = document.querySelector<HTMLElement>("[data-blog-filters]");
  const grid = document.querySelector<HTMLElement>("[data-blog-grid]");
  const empty = document.querySelector<HTMLElement>("[data-blog-empty]");

  if (filters && grid && empty) {
    const search = filters.querySelector<HTMLInputElement>("[data-blog-search]")!;
    const buttons = [...filters.querySelectorAll<HTMLButtonElement>("[data-category]")];
    const cards = [...grid.querySelectorAll<HTMLElement>("[data-post]")];
    const allLabel = buttons[0]?.dataset.category ?? "All";

    let category = allLabel;

    const apply = () => {
      const query = search.value.trim().toLowerCase();
      let visible = 0;

      for (const card of cards) {
        const matchesCategory = category === allLabel || card.dataset.category === category;
        const matchesSearch = !query || (card.dataset.search ?? "").includes(query);
        const show = matchesCategory && matchesSearch;
        card.hidden = !show;
        if (show) visible++;
      }

      empty.hidden = visible > 0;
      grid.hidden = visible === 0;
    };

    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        category = button.dataset.category!;
        buttons.forEach((b) =>
          b.setAttribute("aria-pressed", b === button ? "true" : "false")
        );
        apply();
      })
    );

    search.addEventListener("input", apply);

    empty.querySelector("[data-blog-reset]")!.addEventListener("click", () => {
      search.value = "";
      category = allLabel;
      buttons.forEach((b, i) => b.setAttribute("aria-pressed", i === 0 ? "true" : "false"));
      apply();
    });
  }
</script>
