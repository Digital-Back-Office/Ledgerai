---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopBar from "../../components/TopBar.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import PageHead from "../../components/PageHead.astro";
import Toc from "../../components/Toc.astro";
import { formatDate, getPosts, getSection, getSite } from "../../lib/content";
import { blogPosting, breadcrumbs } from "../../lib/schema";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts();
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
};

const brand = await getSite("brand");
const cta = await getSection("blog-post-cta");
const { entry } = Astro.props;
const post = entry.data;

// Markdown is compiled to HTML here, at build time, so crawlers receive the
// full article rather than an empty element. `headings` feeds the contents
// list: Astro gives every markdown heading an id to link to.
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2);

const posts = await getPosts();
const index = posts.findIndex((p) => p.id === entry.id);
const prevPost = index > 0 ? posts[index - 1] : null;
const nextPost = index < posts.length - 1 ? posts[index + 1] : null;
const relatedPosts = posts.filter((p) => post.related.includes(p.id));
const neighbours = [
  prevPost && { post: prevPost, next: false },
  nextPost && { post: nextPost, next: true },
].filter((n): n is { post: (typeof posts)[number]; next: boolean } => Boolean(n));

const jsonLd = [
  blogPosting(brand, post, entry.id),
  breadcrumbs(brand, [
    { name: "Home", item: "/" },
    { name: "Blogs", item: "/blogs" },
    { name: post.title, item: `/blogs/${entry.id}` },
  ]),
];
---

<BaseLayout
  title={post.seo.title}
  description={post.seo.description}
  canonical={`/blogs/${entry.id}`}
  ogTitle={post.seo.ogTitle}
  ogDescription={post.seo.ogDescription}
  ogImage={post.coverImage}
  ogType="article"
  jsonLd={jsonLd}
>
  <TopBar />
  <Nav />

  <main id="main">
    <article>
      <PageHead
        trail={[{ name: "Blogs", item: "/blogs" }, { name: post.title }]}
        label={post.category}
      >
        <Fragment slot="title">{post.title}</Fragment>

        <p
          slot="meta"
          class="anim anim-up flex flex-wrap items-center gap-x-3 gap-y-1 mt-7 text-sm text-mute"
          style="--anim-delay: 0.16s"
        >
          <span class="max-sm:w-full font-medium text-ink">{post.author}</span>
          <span aria-hidden="true" class="max-sm:hidden text-rule">/</span>
          <time class="fig" datetime={post.date}>{formatDate(post.date)}</time>
          <span aria-hidden="true" class="text-rule">/</span>
          <span class="fig">{post.readingTime}</span>
        </p>

        {/* The cover hangs off the bottom of the header band. */}
        <div
          slot="bleed"
          class="anim anim-up aspect-[16/9] sm:aspect-[21/9] rounded-md overflow-hidden bg-white border border-rule shadow-[0_30px_60px_-30px_rgb(11_18_32/0.45)]"
          style="--anim-delay: 0.24s"
        >
          <img
            src={post.coverImage}
            alt={post.title}
            width="1200"
            height="514"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>
      </PageHead>

      {/* The top padding clears the part of the cover that overhangs the band. */}
      <div class="wrap pt-32 pb-20 lg:pt-44 lg:pb-28">
        <div class="grid grid-cols-1 gap-x-12 lg:grid-cols-12">
          {/* Contents: a sticky rail on wide screens. */}
          <aside
            class="hidden lg:block lg:col-span-3 lg:sticky lg:top-24 lg:self-start lg:max-h-[calc(100dvh-7rem)] lg:overflow-y-auto lg:pr-2"
          >
            {
              toc.length > 1 && (
                <nav aria-label="In this article">
                  <p class="label mb-4">In this article</p>
                  <Toc headings={toc} />
                </nav>
              )
            }
            <a
              href="/blogs"
              class="group inline-flex items-center gap-2 mt-8 text-sm font-medium text-ink"
            >
              <Icon
                name="ArrowLeft"
                size={14}
                class="transition-transform duration-300 group-hover:-translate-x-1"
              />
              <span class="group-hover:underline decoration-brand decoration-2 underline-offset-4">
                All articles
              </span>
            </a>
          </aside>

          <div class="min-w-0 lg:col-span-8 lg:col-start-5">
            {/* Contents: a collapsed box above the text on small screens. */}
            {
              toc.length > 1 && (
                <details class="group lg:hidden mb-10 rounded-md border border-rule bg-paper">
                  <summary class="flex items-center justify-between gap-4 px-4 py-3.5 cursor-pointer list-none [&::-webkit-details-marker]:hidden font-medium text-ink">
                    In this article
                    <Icon
                      name="ChevronDown"
                      size={16}
                      class="transition-transform duration-200 group-open:rotate-180"
                    />
                  </summary>
                  <nav aria-label="In this article" class="px-4 pb-4">
                    <Toc headings={toc} />
                  </nav>
                </details>
              )
            }

            <div class="prose-content select-text [&>*:first-child]:mt-0">
              <Content />
            </div>
          </div>
        </div>

        {/* Pagination: a first or last post has one neighbour, which then
             takes the full width rather than leaving half the row empty. */}
        {
          neighbours.length > 0 && (
            <nav
              aria-label="More articles"
              class:list={[
                "grid grid-cols-1 border-y border-ink mt-16 lg:mt-24",
                neighbours.length === 2 && "sm:grid-cols-2",
              ]}
            >
              {neighbours.map(({ post: other, next }, i) => (
                <a
                  href={`/blogs/${other.id}`}
                  rel={next ? "next" : "prev"}
                  class:list={[
                    "group py-6 border-ink",
                    next && "sm:text-right",
                    i === 1 && "border-t sm:border-t-0 sm:border-l sm:pl-8",
                    i === 0 && neighbours.length === 2 && "sm:pr-8",
                  ]}
                >
                  <span
                    class:list={[
                      "flex items-center gap-2 text-sm text-mute mb-2",
                      next && "sm:justify-end",
                    ]}
                  >
                    {!next && (
                      <Icon
                        name="ArrowLeft"
                        size={14}
                        class="transition-transform duration-300 group-hover:-translate-x-1"
                      />
                    )}
                    {next ? "Next article" : "Previous article"}
                    {next && (
                      <Icon
                        name="ArrowRight"
                        size={14}
                        class="transition-transform duration-300 group-hover:translate-x-1"
                      />
                    )}
                  </span>
                  <span class="h-row text-2xl line-clamp-2 group-hover:underline decoration-brand decoration-2 underline-offset-4">
                    {other.data.title}
                  </span>
                </a>
              ))}
            </nav>
          )
        }
      </div>
    </article>

    {/* Related */}
    {
      relatedPosts.length > 0 && (
        <section class="bg-paper grid-paper border-t border-rule">
          <div class="wrap pt-16 pb-20 lg:pt-20 lg:pb-24">
            <h2 class="h-section mb-10">Related articles</h2>

            <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
              {relatedPosts.map((related) => (
                <article class="sheet group flex flex-col overflow-hidden">
                  <a
                    href={`/blogs/${related.id}`}
                    tabindex="-1"
                    aria-hidden="true"
                    class="block aspect-[16/9] overflow-hidden bg-paper"
                  >
                    <img
                      src={related.data.coverImage}
                      alt=""
                      width="640"
                      height="360"
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                    />
                  </a>
                  <div class="flex flex-col grow p-6 sm:p-7">
                    <p class="flex items-center gap-3 text-[0.8125rem] text-mute mb-3">
                      <span class="font-medium text-ink">{related.data.category}</span>
                      <span aria-hidden="true" class="text-rule">
                        /
                      </span>
                      <span class="fig">{related.data.readingTime}</span>
                    </p>
                    <h3 class="h-row text-2xl">
                      <a
                        href={`/blogs/${related.id}`}
                        class="group-hover:underline decoration-brand decoration-2 underline-offset-4"
                      >
                        {related.data.title}
                      </a>
                    </h3>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {/* Booking CTA */}
    <section class="bg-brand text-ink">
      <div class="wrap py-16 lg:py-20 grid grid-cols-1 gap-x-12 gap-y-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <h2 class="h-section max-w-[20ch]">{cta.heading}</h2>
          <p class="mt-4 text-lg leading-relaxed text-ink/80 max-w-[58ch]">{cta.subheading}</p>
        </div>
        <div class="lg:col-span-4 lg:justify-self-end">
          <a href={cta.ctas[0]?.href} class="btn btn-ink">
            {cta.ctas[0]?.label}
            <Icon name="ArrowRight" size={16} class="arrow" />
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
