---
/**
 * Human-readable sitemap.
 *
 * The XML sitemap that @astrojs/sitemap emits is for crawlers; this is the
 * version a visitor can read. Every link is derived from the same content
 * collections the rest of the site renders from, so a new post or policy shows
 * up here without anyone remembering to edit this file.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import TopBar from "../components/TopBar.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import PageHead from "../components/PageHead.astro";
import {
  formatDate,
  getLegalPages,
  getPosts,
  getSection,
  getSite,
  getSolutions,
} from "../lib/content";
import { breadcrumbs } from "../lib/schema";

const brand = await getSite("brand");
const navigation = await getSite("navigation");
const { integrations: platforms } = await getSite("integrations");
const section = await getSection("sitemap");
const posts = await getPosts();
const legal = await getLegalPages();
const solutions = await getSolutions();

const site = (brand.url ?? "").replace(/\/$/, "");

/**
 * On-page anchors come from the nav, so the two can't drift apart. So does the
 * integrations page, noted with the platforms it currently covers.
 */
const integrationsLink = navigation.links.find((link) => link.href === "/integrations");
const homeLinks = [
  { label: "Home", href: "/", note: "Overview of the product" },
  ...navigation.links
    .filter((link) => link.href.startsWith("/#"))
    .map((link) => ({ label: link.label, href: link.href, note: undefined })),
  { label: "Pricing", href: "/pricing", note: "Plans and allowances" },
  ...(integrationsLink
    ? [{ ...integrationsLink, note: platforms.map((platform) => platform.name).join(", ") }]
    : []),
  { label: "Book a demo", href: "/#book-demo", note: "Talk to the team" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: section.pageTitle,
    description: section.pageDescription,
    url: `${site}/sitemap`,
    inLanguage: "en-GB",
    isPartOf: { "@id": `${site}/#website` },
    publisher: { "@id": `${site}/#organization` },
  },
  breadcrumbs(brand, [
    { name: "Home", item: "/" },
    { name: "Sitemap", item: "/sitemap" },
  ]),
];

/** Every group is the same shape: a heading over ruled rows of label + note. */
const groups: {
  id: string;
  title: string;
  wide?: boolean;
  links: { label: string; href: string; note?: string; datetime?: string }[];
}[] = [
  {
    id: "sitemap-pages",
    title: "Main pages",
    links: [
      ...homeLinks,
      {
        label: "Blogs",
        href: "/blogs",
        note: `${posts.length} article${posts.length === 1 ? "" : "s"}`,
      },
      { label: navigation.login.label, href: navigation.login.href, note: "App" },
    ],
  },
  {
    id: "sitemap-solutions",
    title: "Solutions",
    links: solutions.map((page) => ({
      label: page.data.shortTitle,
      href: page.data.url,
      note: page.data.tagline,
    })),
  },
  {
    id: "sitemap-legal",
    title: "Legal",
    links: [
      ...legal.map((page) => ({
        label: page.data.title,
        href: `/legal/${page.id}`,
        note: formatDate(page.data.updated),
        datetime: page.data.updated,
      })),
      { label: "XML sitemap", href: "/sitemap.xml", note: "For search engines" },
      { label: "RSS feed", href: "/rss.xml", note: "Latest posts" },
    ],
  },
  // Every post, grouped by category so the list stays scannable.
  ...[...new Set(posts.map((post) => post.data.category))].map((category, i) => ({
    id: `sitemap-blog-${i}`,
    title: `Blog · ${category}`,
    links: posts
      .filter((post) => post.data.category === category)
      .map((post) => ({
        label: post.data.title,
        href: `/blogs/${post.id}`,
        note: formatDate(post.data.date),
        datetime: post.data.date,
      })),
  })),
];
---

<BaseLayout
  title={section.pageTitle!}
  description={section.pageDescription}
  canonical="/sitemap"
  ogTitle={section.pageTitle}
  ogDescription={section.pageDescription}
  jsonLd={jsonLd}
>
  <TopBar />
  <Nav />

  <main id="main">
    <PageHead trail={[{ name: "Sitemap" }]} label={section.badge} lede={section.subheading}>
      <Fragment slot="title">
        {section.headline?.before}<span class="mark">{section.headline?.accent}</span
        >{section.headline?.after}
      </Fragment>
    </PageHead>

    <div class="wrap pt-12 pb-20 lg:pt-16 lg:pb-28">
      <div class="gap-5 md:columns-2">
        {
          groups.map((group) => (
            <section
              aria-labelledby={group.id}
              class="sheet break-inside-avoid mb-5 px-5 sm:px-7 pt-6 pb-2"
            >
              <h2 id={group.id} class="flex items-baseline justify-between gap-4 h-row pb-4 border-b border-ink">
                {group.title}
                <span class="fig text-xs font-normal text-mute">
                  {String(group.links.length).padStart(2, "0")}
                </span>
              </h2>
              <ul>
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="group flex items-baseline justify-between gap-6 border-b border-rule py-3.5 [li:last-child>&]:border-b-0"
                    >
                      <span class="min-w-0 font-medium text-ink group-hover:underline decoration-brand decoration-2 underline-offset-4">
                        {link.label}
                      </span>
                      {link.note &&
                        (link.datetime ? (
                          <time
                            datetime={link.datetime}
                            class="fig shrink-0 text-[0.8125rem] text-mute"
                          >
                            {link.note}
                          </time>
                        ) : (
                          <span class="hidden sm:block max-w-[50%] text-right text-[0.8125rem] text-mute">
                            {link.note}
                          </span>
                        ))}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <p class="mt-9 pt-6 border-t border-rule text-mute">
        Can't find what you're looking for? <a href="/#book-demo" class="link">Get in touch</a>.
      </p>
    </div>
  </main>

  <Footer />
  <CookieConsent />
</BaseLayout>
