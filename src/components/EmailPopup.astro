---
import Icon from "./Icon.astro";
import { getSection, getSite } from "../lib/content";

const brand = await getSite("brand");
const section = await getSection("email-popup");
const { badge, headline, subheading, scarcity, form, trustPoints } = section;
---

<div
  data-email-popup
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="email-popup-title"
  class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-ink/65"
>
  <div data-popup-card class="sheet relative w-full max-w-lg overflow-hidden">
    {/* A solid brand edge instead of a glow. */}
    <div class="h-1.5 bg-brand" aria-hidden="true"></div>

    <button
      type="button"
      data-popup-close
      aria-label="Close"
      class="absolute top-5 right-4 grid place-items-center size-9 text-mute hover:text-ink transition-colors z-10 cursor-pointer"
    >
      <Icon name="X" size={20} />
    </button>

    <div class="px-6 pt-8 pb-7 sm:px-9 sm:pt-10 sm:pb-9">
      {/* Success state */}
      <div data-popup-success hidden>
        <div class="py-4">
          <span class="grid place-items-center size-12 bg-brand rounded-md mb-6">
            <Icon name="Check" size={26} strokeWidth={2.5} class="text-ink" />
          </span>

          <h4 class="h-section text-3xl mb-3">{form?.successTitle}</h4>
          <p class="text-mute leading-relaxed max-w-[40ch] mb-6">{form?.successMessage}</p>

          <p class="label">{form?.note}</p>
        </div>
      </div>

      {/* Idle state */}
      <div data-popup-idle>
        <p class="label mb-5">{badge}</p>

        <h3 id="email-popup-title" class="h-section pr-8">
          {headline?.before} <span class="mark">{headline?.accent}</span>
        </h3>
        <p class="text-mute mt-4 mb-7 leading-relaxed">{subheading}</p>

        {/* Remaining spots */}
        {
          scarcity && (
            <div class="mb-7" data-scarcity={JSON.stringify(scarcity)}>
              <div class="flex items-baseline justify-between gap-4 mb-2 text-sm">
                <span class="font-medium text-ink" data-spots-label />
                <span class="fig text-xs text-mute" data-claimed-label />
              </div>
              <div class="h-1.5 w-full bg-paper border border-rule overflow-hidden">
                <div
                  data-scarcity-bar
                  class="h-full bg-ink transition-all duration-500"
                  style="width: 0%"
                />
              </div>
            </div>
          )
        }

        <form
          data-popup-form
          data-error={form?.errorMessage}
          data-connection-error={form?.connectionErrorMessage}
          class="space-y-2.5"
        >
          <input type="hidden" name="access_key" value={brand.formAccessKey} />
          <input type="hidden" name="source" value={form?.source} />
          <label for="popup-email" class="sr-only">{form?.placeholder}</label>
          <input
            id="popup-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder={form?.placeholder}
            class="field min-h-13 text-base"
          />
          <button type="submit" class="btn btn-primary w-full min-h-13 text-base">
            <span data-label>{form?.submitLabel}</span>
            <span data-loading class="inline-flex items-center gap-2" hidden>
              <Icon name="Loader" size={18} class="animate-spin" />
              {form?.loadingLabel}
            </span>
          </button>
        </form>
        <p data-popup-error class="text-sm text-red-700 mt-2.5" role="alert" hidden></p>

        <div class="flex flex-wrap items-center gap-x-5 gap-y-1.5 mt-5 text-[0.8125rem] text-mute">
          {
            trustPoints.map((point) => (
              <span class="flex items-center gap-2">
                <span aria-hidden="true" class="size-1.5 bg-brand" />
                {point}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  interface Scarcity {
    totalSpots: number;
    baseSpotsLeft: number;
    minSpotsLeft: number;
    decayStart: string;
    decayEveryDays: number;
    decayAmount: number;
    label: string;
    claimedLabel: string;
  }

  const popup = document.querySelector<HTMLElement>("[data-email-popup]");

  if (popup) {
    const idle = popup.querySelector<HTMLElement>("[data-popup-idle]")!;
    const success = popup.querySelector<HTMLElement>("[data-popup-success]")!;
    const form = popup.querySelector<HTMLFormElement>("[data-popup-form]")!;
    const errorEl = popup.querySelector<HTMLElement>("[data-popup-error]")!;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const label = button.querySelector<HTMLElement>("[data-label]")!;
    const loading = button.querySelector<HTMLElement>("[data-loading]")!;
    const input = form.querySelector<HTMLInputElement>("input[name=email]")!;
    const scarcityEl = popup.querySelector<HTMLElement>("[data-scarcity]");

    let submitted = false;
    let emailStarted = false;

    const fill = (text: string, vars: Record<string, number>) =>
      text.replace(/\{(\w+)\}/g, (m, k) => (k in vars ? String(vars[k]) : m));

    /**
     * Spots remaining today: starts at `baseSpotsLeft` and drops `decayAmount`
     * every `decayEveryDays` from `decayStart`, never below `minSpotsLeft`.
     * Signing up takes one more so it feels personal to this visitor.
     */
    const renderScarcity = () => {
      if (!scarcityEl) return;
      const s: Scarcity = JSON.parse(scarcityEl.dataset.scarcity!);
      const signedUp = !!localStorage.getItem("ledgerSignedUp");

      const days = Math.floor(
        (Date.now() - Date.parse(s.decayStart + "T00:00:00")) / 86_400_000
      );
      let left = s.baseSpotsLeft;
      if (days >= 0) {
        const periods = Math.floor(days / s.decayEveryDays) + 1;
        left = s.baseSpotsLeft - periods * s.decayAmount;
      }
      if (signedUp) left -= 1;
      left = Math.max(s.minSpotsLeft, left);

      const claimed = s.totalSpots - left;
      scarcityEl.querySelector("[data-spots-label]")!.textContent = fill(s.label, {
        left,
        total: s.totalSpots,
      });
      scarcityEl.querySelector("[data-claimed-label]")!.textContent = fill(s.claimedLabel, {
        claimed,
      });
      scarcityEl.querySelector<HTMLElement>("[data-scarcity-bar]")!.style.width =
        `${(claimed / s.totalSpots) * 100}%`;
    };

    const open = (source: "auto" | "manual" = "manual") => {
      window.gtag?.("event", "popup_opened", {
        event_category: "engagement",
        event_label: source,
      });
      renderScarcity();
      emailStarted = false;
      submitted = false;
      popup.hidden = false;
      document.body.style.overflow = "hidden";
      setTimeout(() => input.focus(), 120);
    };

    const close = () => {
      if (!submitted) {
        window.gtag?.("event", "popup_dismissed", { event_category: "engagement" });
      }
      localStorage.setItem("leadPopupSeen", "true");
      popup.hidden = true;
      document.body.style.overflow = "";
    };

    window.openEmailPopup = () => open("manual");

    // Anything marked `data-open-popup` opens it (top bar, showcase CTA).
    document.querySelectorAll<HTMLElement>("[data-open-popup]").forEach((el) => {
      el.addEventListener("click", (click) => {
        // The top-bar trigger is a link to `/?offer=1` so it still leads
        // somewhere on pages without the popup; here it opens in place.
        click.preventDefault();
        const event = el.dataset.event;
        if (event) {
          window.gtag?.("event", event, {
            event_category: "engagement",
            event_label: el.dataset.eventLabel,
          });
        }
        open("manual");
      });
    });

    // Arriving from that link on another page: open the offer straight away,
    // then drop the flag so a refresh or a shared URL does not reopen it.
    const arrival = new URL(window.location.href);
    if (arrival.searchParams.has("offer")) {
      arrival.searchParams.delete("offer");
      history.replaceState(null, "", arrival.pathname + arrival.search + arrival.hash);
      open("manual");
    }

    popup.querySelector("[data-popup-close]")!.addEventListener("click", close);
    popup.addEventListener("click", (e) => {
      if (e.target === popup) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !popup.hidden) close();
    });

    // Auto-open once per visitor when they reach the "how it works" section.
    if (!localStorage.getItem("leadPopupSeen")) {
      const target = document.getElementById("how-it-works");
      if (target) {
        const observer = new IntersectionObserver(
          (entries) => {
            if (entries[0].isIntersecting) {
              open("auto");
              localStorage.setItem("leadPopupSeen", "true");
              observer.disconnect();
            }
          },
          { threshold: 0.25 }
        );
        observer.observe(target);
      }
    }

    input.addEventListener("input", () => {
      if (!emailStarted && input.value.length > 0) {
        emailStarted = true;
        window.gtag?.("event", "email_started", {
          event_category: "engagement",
          event_label: "popup",
        });
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      button.disabled = true;
      label.hidden = true;
      loading.hidden = false;
      errorEl.hidden = true;

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: new FormData(form),
        });
        const data = await response.json();

        if (data.success) {
          localStorage.setItem("ledgerSignedUp", "true");
          submitted = true;
          window.gtag?.("event", "form_submitted", {
            event_category: "conversion",
            event_label: "popup",
          });
          idle.hidden = true;
          success.hidden = false;
        } else {
          errorEl.textContent = form.dataset.error!;
          errorEl.hidden = false;
        }
      } catch {
        errorEl.textContent = form.dataset.connectionError!;
        errorEl.hidden = false;
      } finally {
        button.disabled = false;
        label.hidden = false;
        loading.hidden = true;
      }
    });
  }
</script>
