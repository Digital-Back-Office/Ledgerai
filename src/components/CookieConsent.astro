---
import { getSection } from "../lib/content";

const section = await getSection("cookie-consent");
const [decline, accept] = section.ctas;

// The copy carries a `{links}` token so the policy links stay editable in markdown.
const [before, after] = (section.subheading ?? "").split("{links}");
---

<div
  data-cookie-consent
  hidden
  role="region"
  aria-label={section.heading}
  class="sheet fixed bottom-3 left-3 right-3 sm:left-auto sm:bottom-5 sm:right-5 sm:max-w-md z-50 p-5"
>
  <h3 class="font-display font-semibold text-lg tracking-tight text-ink mb-1.5">
    {section.heading}
  </h3>
  <p class="text-sm text-mute leading-relaxed">
    {before}
    {
      section.links.map((link, i) => (
        <>
          {i > 0 && " and "}
          <a href={link.href} class="link">
            {link.label}
          </a>
        </>
      ))
    }
    {after}
  </p>

  <div class="flex gap-2.5 mt-4">
    <button type="button" data-cookie-accept class="btn btn-sm btn-ink flex-1">
      {accept?.label}
    </button>
    <button type="button" data-cookie-decline class="btn btn-sm btn-line flex-1">
      {decline?.label}
    </button>
  </div>
</div>

<script>
  const banner = document.querySelector<HTMLElement>("[data-cookie-consent]");

  if (banner && !localStorage.getItem("cookieConsent")) {
    banner.hidden = false;

    const dismiss = (choice: string) => {
      localStorage.setItem("cookieConsent", choice);
      banner.hidden = true;
    };

    banner
      .querySelector("[data-cookie-accept]")
      ?.addEventListener("click", () => dismiss("accepted"));
    banner
      .querySelector("[data-cookie-decline]")
      ?.addEventListener("click", () => dismiss("declined"));
  }
</script>
