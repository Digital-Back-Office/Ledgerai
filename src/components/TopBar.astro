---
import { getSection } from "../lib/content";

const { announcement } = await getSection("topbar");
---

{
  announcement && (
    <div class="bg-ink text-white">
      <div class="wrap h-(--bar-h) flex items-center justify-center text-[0.9375rem] sm:text-base md:text-lg">
        {/* A link, not a button: the offer popup only exists on the home page,
             so everywhere else this goes there and the popup opens on arrival
             (see EmailPopup). On the home page the popup opens in place. */}
        <a
          href="/?offer=1"
          data-open-popup
          data-event="banner_click"
          class="group flex items-center gap-2.5 cursor-pointer min-w-0"
        >
          <span aria-hidden="true" class="size-2 bg-brand shrink-0" />
          <span class="truncate">
            {announcement.before} <span class="font-semibold">{announcement.highlight}</span>{" "}
            {announcement.after}
          </span>
          <span class="hidden sm:inline underline decoration-brand decoration-2 underline-offset-4 group-hover:decoration-white transition-colors">
            {announcement.linkLabel}
          </span>
        </a>
      </div>
    </div>
  )
}
