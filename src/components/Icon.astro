---
/**
 * Inline icon: a lucide glyph, or one of the few product marks in
 * `brand-icons.ts` (Gmail).
 *
 * The React site pulled these from `lucide-react`, which meant every icon
 * needed the client bundle before it appeared. Here the SVG is emitted
 * straight into the HTML, so icons are present for crawlers and paint with
 * the first byte.
 *
 * Product marks keep their own colours, so `strokeWidth` and text colour
 * classes have no effect on them.
 */
import { BRAND_ICONS, type BrandIconName } from "./brand-icons";
import { ICONS, type IconName } from "./icons-data";

interface Props {
  name: IconName | BrandIconName;
  /** lucide's `size` prop — sets both width and height. */
  size?: number;
  class?: string;
  strokeWidth?: number;
  /** Set when the icon carries meaning on its own rather than decorating a label. */
  title?: string;
}

const {
  name,
  size = 24,
  class: className = "",
  strokeWidth = 2,
  title,
} = Astro.props;

const brand = name in BRAND_ICONS ? BRAND_ICONS[name as BrandIconName] : undefined;
const body = brand ? brand.body : ICONS[name as IconName];
---

{
  brand ? (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      viewBox={brand.viewBox}
      class={`shrink-0 ${className}`}
      role={title ? "img" : undefined}
      aria-label={title}
      aria-hidden={title ? undefined : "true"}
      set:html={body}
    />
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      class={`lucide shrink-0 ${className}`}
      role={title ? "img" : undefined}
      aria-label={title}
      aria-hidden={title ? undefined : "true"}
      set:html={body}
    />
  )
}
