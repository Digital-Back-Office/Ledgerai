---
import BookingForm from "./BookingForm.astro";
import { getSection } from "../lib/content";

const section = await getSection("book-demo");
const { eyebrow, heading, subheading, testimonial, form } = section;
---

{/* The one ink band on the page: the closing statement before the footer. */}
<section id="book-demo" class="on-dark grid-paper bg-ink text-white">
  <div class="wrap pt-20 pb-24 lg:pt-28 lg:pb-32">
    <div class="anim anim-up grid gap-x-12 gap-y-12 lg:grid-cols-12 lg:items-start">
      {/* Copy */}
      <div class="lg:col-span-6">
        <p class="label label-dark mb-5">{eyebrow}</p>
        <h2 class="h-section text-white max-w-[18ch]">{heading}</h2>
        <p class="lede mt-5 text-white/70 max-w-[50ch]">{subheading}</p>

        {
          testimonial && (
            <figure class="mt-12 border-l-2 border-brand pl-6 max-w-[46ch]">
              <blockquote class="font-display text-xl sm:text-2xl leading-snug tracking-tight text-white">
                “{testimonial.quote}”
              </blockquote>
            </figure>
          )
        }
      </div>

      {/* Form */}
      <div class="lg:col-span-5 lg:col-start-8 bg-white text-ink rounded-md p-6 sm:p-8">
        <h3 class="h-row">{form?.title}</h3>
        <p class="text-mute text-[0.9375rem] mt-1.5 mb-6">{form?.subtitle}</p>
        <BookingForm />
      </div>
    </div>
  </div>
</section>
