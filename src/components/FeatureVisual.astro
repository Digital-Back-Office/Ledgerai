---
/**
 * The mock UI shown with each feature. All five are real markup, so the sample
 * data stays crawlable.
 *
 * Each one is drawn as ruled rows on a single sheet rather than a stack of
 * little cards, so it reads like the working document it stands in for.
 *
 * The same panel appears in cards from about 350px to 570px wide, so each list
 * is a container and its rows adapt to the space they are given (`@md:` is a
 * 28rem container, not a viewport width): side by side when there is room,
 * stacked when there is not. Nothing is truncated that could simply wrap.
 */
import Icon from "./Icon.astro";
import type { CollectionEntry } from "astro:content";
import type { IconName } from "./icons-data";

interface Props {
  feature: CollectionEntry<"features">["data"];
}

const { feature } = Astro.props;

/** Staggered entrance. */
const row = (delay: number, from = "translateY(8px)") =>
  `--row-delay: ${delay.toFixed(2)}s; --row-from: ${from};`;

const line = "visual-row border-b border-rule last:border-0 px-5 sm:px-7";
/** Two blocks that sit on one line in a wide panel and stack in a narrow one. */
const pair = "flex-1 min-w-0 @md:flex @md:items-center @md:gap-4";
---

{
  feature.visual === "email" && (
    <ul class="@container">
      {feature.emails.map((email, i) => (
        <li class={`${line} grid grid-cols-[3rem_minmax(0,1fr)] gap-x-4 py-4`} style={row(i * 0.16)}>
          <span class="fig text-xs text-mute pt-0.5">{email.time}</span>
          <div class="min-w-0">
            <p class="text-xs text-mute truncate">{email.from}</p>
            <p class="text-[0.9375rem] font-medium leading-snug text-ink">{email.subject}</p>
            <p
              class="visual-row mt-1.5 flex items-center gap-1.5 text-xs text-ink"
              style={row(i * 0.16 + 0.45, "none")}
            >
              <Icon name="Check" size={13} strokeWidth={2.5} class="text-brand-dark" />
              {feature.emailNote}
            </p>
          </div>
        </li>
      ))}
    </ul>
  )
}

{
  feature.visual === "statements" && (
    <ul class="@container">
      {feature.banks.map((bank, i) => (
        <li class={`${line} flex items-center gap-4 py-3.5`} style={row(i * 0.14)}>
          <span
            class="grid place-items-center size-8 rounded-[3px] font-display font-bold text-white text-sm shrink-0"
            style={`background-color: ${bank.color}`}
            aria-hidden="true"
          >
            {bank.name[0]}
          </span>
          <div class="flex-1 min-w-0">
            <p class="text-[0.9375rem] font-medium leading-snug text-ink">
              {bank.name} <span class="text-mute font-normal">· {bank.client}</span>
            </p>
            <p class="fig text-xs text-mute mt-0.5">
              {/* The date range is the first thing to go when space is tight. */}
              <span class="hidden @md:inline">{bank.date} · </span>
              {bank.transactions} transactions
            </p>
          </div>
          <span
            class="visual-row flex items-center gap-1.5 text-xs font-medium text-ink shrink-0"
            style={row(i * 0.14 + 0.4, "none")}
          >
            <Icon name="Check" size={13} strokeWidth={2.5} class="text-brand-dark" />
            {feature.bankBadge}
          </span>
        </li>
      ))}
    </ul>
  )
}

{
  feature.visual === "categorise" && (
    <ul class="@container">
      {feature.transactions.map((txn, i) => (
        <li class={`${line} flex items-center gap-4 py-3`} style={row(i * 0.13)}>
          <div class={pair}>
            <p class="text-[0.9375rem] leading-snug text-ink @md:flex-1">{txn.name}</p>
            <p
              class="visual-row flex items-center gap-2 mt-1 @md:mt-0 text-xs font-medium text-ink shrink-0"
              style={row(i * 0.13 + 0.35, "none")}
            >
              <span
                class="size-2 rounded-[1px]"
                style={`background-color: ${txn.color}`}
                aria-hidden="true"
              />
              {txn.category}
            </p>
          </div>
          <span class="fig text-sm text-ink text-right shrink-0 @md:w-20">{txn.amount}</span>
        </li>
      ))}
    </ul>
  )
}

{
  feature.visual === "alerts" && (
    <ul class="@container">
      {feature.alerts.map((alert, i) => (
        <li class={`${line} flex items-center gap-4 py-3`} style={row(i * 0.16)}>
          <span style={`color: ${alert.color}`} class="shrink-0">
            <Icon name={alert.icon as IconName} size={18} />
          </span>
          <div class={pair}>
            <p class="text-[0.9375rem] font-medium leading-snug text-ink @md:flex-1">
              {alert.company}
            </p>
            <p class="mt-1 @md:mt-0 text-xs text-mute shrink-0">
              {alert.bank} · {alert.label}
            </p>
          </div>
        </li>
      ))}
    </ul>
  )
}

{
  feature.visual === "balance" && feature.ledger && (
    <div class="@container">
      <div class="grid grid-cols-[minmax(0,1fr)_4.5rem_4.5rem] @md:grid-cols-[minmax(0,1fr)_6.5rem_6.5rem] px-5 sm:px-7 py-2.5 text-xs font-medium text-mute border-b border-ink">
        {feature.ledger.columns.map((column, i) => (
          <span class={i === 0 ? "" : "text-right"}>{column}</span>
        ))}
      </div>
      {feature.ledger.rows.map((entry, i) => (
        <div
          class={`${line} grid grid-cols-[minmax(0,1fr)_4.5rem_4.5rem] @md:grid-cols-[minmax(0,1fr)_6.5rem_6.5rem] items-baseline py-3 text-[0.9375rem]`}
          style={row(i * 0.11, "none")}
        >
          <span class="leading-snug text-ink wrap-anywhere">{entry.account}</span>
          <span class="fig text-sm text-right text-ink">{entry.debit}</span>
          <span class="fig text-sm text-right text-ink">{entry.credit}</span>
        </div>
      ))}
      <p
        class="visual-row flex items-start gap-2 px-5 sm:px-7 py-3.5 border-t border-ink text-sm font-medium text-ink"
        style={row(0.8, "none")}
      >
        <Icon name="Check" size={15} strokeWidth={2.5} class="mt-0.5 text-brand-dark" />
        <span class="fig">{feature.ledger.footer}</span>
      </p>
    </div>
  )
}
