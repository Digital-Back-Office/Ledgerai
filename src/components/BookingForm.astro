---
import Icon from "./Icon.astro";
import { getSection, getSite } from "../lib/content";

const brand = await getSite("brand");
const { form } = await getSection("book-demo");
---

{
  form && (
    <div>
      <div data-booking-success hidden>
        <div class="py-6">
          <span class="grid place-items-center size-11 bg-brand rounded-md mb-5">
            <Icon name="Check" size={22} strokeWidth={2.5} class="text-ink" />
          </span>
          <h3 class="h-row text-2xl mb-2">{form.successTitle}</h3>
          <p class="text-mute mb-1">{form.successMessage}</p>
          <p class="text-mute text-sm">
            We'll send a confirmation to <span class="text-ink font-medium" data-booking-email />
          </p>
        </div>
      </div>

      <form
        data-booking-form
        data-conversion={brand.bookingConversionLabel}
        data-error={form.errorMessage}
        data-connection-error={form.connectionErrorMessage}
        class="space-y-4"
      >
        <input type="hidden" name="access_key" value={brand.formAccessKey} />
        <input type="hidden" name="source" value={form.source} />

        {/* Visible labels rather than placeholder-only fields: the label stays
             readable once the visitor starts typing. */}
        {form.fields.map((field) => (
          <div>
            <label
              for={`booking-${field.name}`}
              class="block text-sm font-medium text-ink mb-1.5"
            >
              {field.placeholder}
            </label>
            <input
              id={`booking-${field.name}`}
              type={field.type}
              name={field.name}
              required={field.required}
              autocomplete={
                field.type === "email" ? "email" : field.type === "tel" ? "tel" : undefined
              }
              class="field"
            />
          </div>
        ))}

        <div data-booking-status class="text-sm p-3 rounded-lg" role="status" hidden />

        <button type="submit" class="btn btn-primary w-full">
          <span data-label class="inline-flex items-center gap-2.5">
            {form.submitLabel}
            <Icon name="ArrowRight" size={16} class="arrow" />
          </span>
          <span data-loading class="inline-flex items-center gap-2" hidden>
            <Icon name="Loader" size={16} class="animate-spin" />
            {form.loadingLabel}
          </span>
        </button>

        <p class="text-[0.8125rem] text-mute">{form.note}</p>
      </form>
    </div>
  )
}

<script>
  const form = document.querySelector<HTMLFormElement>("[data-booking-form]");

  if (form) {
    const success = document.querySelector<HTMLElement>("[data-booking-success]")!;
    const emailOut = document.querySelector<HTMLElement>("[data-booking-email]")!;
    const status = form.querySelector<HTMLElement>("[data-booking-status]")!;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const label = button.querySelector<HTMLElement>("[data-label]")!;
    const loading = button.querySelector<HTMLElement>("[data-loading]")!;

    const setStatus = (message: string, ok: boolean) => {
      status.textContent = message;
      status.className = `text-sm p-3 rounded-lg ${
        ok ? "bg-green-50 text-green-700" : "bg-red-50 text-red-700"
      }`;
      status.hidden = false;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      button.disabled = true;
      label.hidden = true;
      loading.hidden = false;
      setStatus("Sending....", true);

      const data = new FormData(form);
      const email = String(data.get("email") ?? "");

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: data,
        });
        const result = await response.json();

        if (result.success) {
          // Google Ads conversion
          window.gtag?.("event", "conversion", {
            send_to: form.dataset.conversion,
            value: 1.0,
            currency: "INR",
          });
          emailOut.textContent = email;
          form.hidden = true;
          success.hidden = false;
        } else {
          setStatus(form.dataset.error!, false);
          button.disabled = false;
        }
      } catch {
        setStatus(form.dataset.connectionError!, false);
        button.disabled = false;
      } finally {
        label.hidden = false;
        loading.hidden = true;
      }
    });
  }
</script>
