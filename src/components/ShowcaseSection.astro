---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import PipelineDiagram from "./PipelineDiagram.astro";
import { getSection, getSite } from "../lib/content";
import heroImg from "../assets/hero.png";

const showcase = await getSection("showcase");
const { badge, headline, subheading, bullets, ctas, image, pipeline } = showcase;
const cta = ctas[0];

// Named under the diagram as the place the cleaned-up books end up. Names
// only: two of the three logo files are still hand-drawn placeholders.
const sync = await getSite("integrations");
---

<section>
  <div class="wrap py-20 lg:py-24">
    <div class="grid gap-5 lg:grid-cols-12">
      {/* Diagram, on squared paper */}
      <figure
        class="anim anim-up grid-paper lg:col-span-7 flex flex-col bg-paper border border-rule rounded-md p-6 sm:p-9"
      >
        {image?.alt && <figcaption class="label mb-8 lg:mb-10">{image.alt}</figcaption>}
        <div class="my-auto">
          {
            pipeline ? (
              <PipelineDiagram pipeline={pipeline} />
            ) : (
              <Image
                src={heroImg}
                alt={image?.alt ?? ""}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1024px) 55vw, 90vw"
                class="w-full h-auto object-contain mix-blend-multiply"
              />
            )
          }
        </div>

        {
          sync.integrations.length > 0 && (
            <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 mt-8 lg:mt-10 pt-5 border-t border-rule">
              <a href="/integrations" class="link text-sm">{sync.menuLabel}</a>
              <ul class="flex flex-wrap gap-1.5">
                {sync.integrations.map((item) => (
                  <li class="tag">{item.name}</li>
                ))}
              </ul>
            </div>
          )
        }
      </figure>

      {/* One month free offer: a solid brand card, not another white box. */}
      <div
        class="anim anim-up lg:col-span-5 flex flex-col bg-brand text-ink rounded-md p-7 sm:p-10"
        style="--anim-delay: 0.1s"
      >
        <p class="flex items-center gap-2.5 text-sm font-medium mb-6">
          <span aria-hidden="true" class="w-5 h-0.5 bg-ink"></span>
          {badge}
        </p>

        <h2 class="h-section">{headline?.before} {headline?.accent}</h2>

        <p class="mt-5 text-lg leading-relaxed text-ink/80">{subheading}</p>

        <ul class="mt-8 mb-9 border-b border-ink/20">
          {
            bullets.map((bullet) => (
              <li class="flex items-start gap-3 border-t border-ink/20 py-3.5 font-medium">
                <Icon name="Check" size={17} strokeWidth={2.5} class="mt-0.5" />
                {bullet.text}
              </li>
            ))
          }
        </ul>

        {
          cta && (
            <button
              type="button"
              data-open-popup
              data-event="cta_click"
              data-event-label={cta.event}
              class="btn btn-ink mt-auto self-start"
            >
              {cta.label}
              <Icon name="ArrowRight" size={16} class="arrow" />
            </button>
          )
        }
      </div>
    </div>
  </div>
</section>
