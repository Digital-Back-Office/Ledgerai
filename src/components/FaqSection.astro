---
import FaqBlock from "./FaqBlock.astro";
import { getOrdered, getSection } from "../lib/content";

const section = await getSection("faq");
const faqs = await getOrdered("faqs");
---

<FaqBlock
  label={section.eyebrow}
  heading={section.heading!}
  sub={section.subheading}
  items={faqs.map((faq) => faq.data)}
  name="faq"
/>
