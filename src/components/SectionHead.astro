---
/**
 * The header every section shares: label and heading on the left, flush with
 * the content below, and the supporting line set against it on the right.
 * Using the full width keeps the top of each section from reading as empty.
 */
interface Props {
  label?: string;
  heading: string;
  sub?: string;
  /** Set on ink-background sections. */
  dark?: boolean;
  class?: string;
}

const { label, heading, sub, dark = false, class: className = "" } = Astro.props;
---

<header
  class:list={[
    "anim anim-up grid gap-x-12 gap-y-5 lg:grid-cols-12 lg:items-end mb-10 lg:mb-14",
    className,
  ]}
>
  <div class="lg:col-span-7">
    {label && <p class:list={["label mb-5", dark && "label-dark"]}>{label}</p>}
    <h2 class:list={["h-section", dark && "text-white"]}>{heading}</h2>
  </div>
  {sub && <p class:list={["lede lg:col-span-5 lg:pb-1", dark && "text-white/70"]}>{sub}</p>}
</header>
