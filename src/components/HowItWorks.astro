---
import Steps from "./Steps.astro";
import { getOrdered, getSection } from "../lib/content";

const section = await getSection("how-it-works");
const steps = await getOrdered("steps");
---

{/* The id is load-bearing: the scroll funnel and the popup trigger observe it. */}
<Steps
  id="how-it-works"
  label={section.eyebrow}
  heading={section.heading!}
  items={steps.map((step) => step.data)}
/>
