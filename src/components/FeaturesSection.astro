---
import FeatureVisual from "./FeatureVisual.astro";
import SectionHead from "./SectionHead.astro";
import { getOrdered, getSection } from "../lib/content";

const section = await getSection("features");
const features = await getOrdered("features");
---

{/* Every feature is on screen at once, each with its own piece of product UI,
     rather than one at a time behind tabs. The first two are set wide. */}
<section id="features" class="border-t border-rule">
  <div class="wrap pt-20 pb-24 lg:pt-28 lg:pb-32">
    <SectionHead label={section.eyebrow} heading={section.heading!} sub={section.subheading} />

    {/* Each card is a two-row subgrid of this grid: copy, then panel. Cards on
         the same row therefore share both row heights, so their panels start
         level however long each description runs. */}
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-6">
      {
        features.map((feature, i) => (
          <article
            class:list={[
              "anim anim-up sheet row-span-2 grid grid-rows-subgrid gap-y-0 overflow-hidden",
              i < 2 ? "lg:col-span-3" : "lg:col-span-2",
              // An odd one out on the two-column tablet grid spans the row.
              i === features.length - 1 && features.length % 2 === 1 && "md:col-span-2",
            ]}
            style={`--anim-delay: ${((i % 3) * 0.08).toFixed(2)}s`}
          >
            <div class="p-6 sm:p-7">
              <p class="fig text-xs text-mute mb-4">
                <span class="text-brand-dark">{String(i + 1).padStart(2, "0")}</span> /{" "}
                {String(features.length).padStart(2, "0")}
              </p>
              <h3 class="h-row text-2xl">{feature.data.title}</h3>
              <p class="text-mute text-[0.9375rem] mt-2.5 leading-relaxed">
                {feature.data.description}
              </p>
            </div>

            {/* A shorter panel leaves tinted paper below it rather than a gap
                 in the card. The rule under the rows is a shadow, so on the
                 tallest panel it falls outside the card and is clipped instead
                 of doubling up with the card's own border. */}
            <div class="border-t border-rule bg-paper">
              <div class="bg-white shadow-[0_1px_0_var(--color-rule)]">
                <FeatureVisual feature={feature.data} />
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
